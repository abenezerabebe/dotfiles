# Always define functions first — they don't propagate across exec, so child
# shells that inherit the __ZSHENV_SHARED guard still need them defined.
_addpath() { [ -d "$1" ] && path+="$1"; }

# Prevent double-sourcing within the same shell.
# Do NOT export — child shells (e.g. tmux panes) must re-source this file so
# shell functions like _addpath get redefined (functions don't propagate
# across exec, only env vars do).
[[ -n "$__ZSHENV_SHARED" ]] && return
__ZSHENV_SHARED=1

# ------------------------------
# Homebrew
# ------------------------------
if [ -x /opt/homebrew/bin/brew ]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi

# ------------------------------
# jenv (Java version manager)
# If present, let jenv own JAVA_HOME and PATH
# ------------------------------
if command -v jenv >/dev/null 2>&1; then
  unset JAVA_HOME
  eval "$(jenv init - zsh)"
else
  # Fallback when jenv is not installed/available: use Java 25
  export JAVA_HOME="$(
    /usr/libexec/java_home -v 25 2>/dev/null || /usr/libexec/java_home 2>/dev/null
  )"
  export PATH="$JAVA_HOME/bin:$PATH"
fi

# ------------------------------
# Common paths
# ------------------------------
path=(
  /opt/homebrew/bin
  /opt/homebrew/sbin
  "$HOME/.local/bin"
  "$HOME/Library/Application Support/JetBrains/Toolbox/scripts"
  "$HOME/.protobuf/bin"
  "$path[@]"
)
typeset -U path PATH
export PATH

# ------------------------------
# pyenv
# ------------------------------
export PYENV_ROOT="$HOME/.pyenv"
if [ -d "$PYENV_ROOT/bin" ]; then
  path+="$PYENV_ROOT/bin"
  export PATH
  if command -v pyenv >/dev/null 2>&1; then
    eval "$(pyenv init - zsh)"
  fi
fi

# ------------------------------
# nvm (Node version manager, lazy load)
# ------------------------------
export NVM_DIR="$HOME/.nvm"
if [ -s "$NVM_DIR/nvm.sh" ]; then
  nvm() { unset -f nvm; . "$NVM_DIR/nvm.sh"; nvm "$@"; }
  node() { unset -f node; . "$NVM_DIR/nvm.sh"; node "$@"; }
  npm()  { unset -f npm;  . "$NVM_DIR/nvm.sh"; npm "$@"; }
  npx()  { unset -f npx;  . "$NVM_DIR/nvm.sh"; npx "$@"; }
fi

# ------------------------------
# Misc utilities
# ------------------------------
export EDITOR="vim"
export LANG="en_US.UTF-8"
export LC_ALL="en_US.UTF-8"

typeset -U path PATH
export PATH
